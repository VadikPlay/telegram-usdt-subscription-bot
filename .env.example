# ─────────────────────────────────────────────────────────────────────────────
#  Gatekit — configuration
#  Copy to .env and fill in. Nothing here is sent anywhere except Telegram
#  and the public blockchain APIs you enable below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=123456789:AAaaBBccDDeeFFggHHiiJJkkLLmmNNooPPq

# Your private channel or group ID (starts with -100...).
# How to get it: add the bot as an admin, post any message in the channel,
# forward it to @RawDataBot (or @getidsbot) and copy "forward_from_chat.id".
CHANNEL_ID=-1001234567890

# Telegram user IDs allowed into the admin panel (comma-separated).
# Get yours from @userinfobot.
ADMIN_IDS=111111111

# Optional: public @username or link shown to users for support.
SUPPORT_CONTACT=@your_username

# Default interface language for new users: en | ru
DEFAULT_LANG=en


# ── Plans ───────────────────────────────────────────────────────────────────
# Format:  code:days:price  (comma-separated). Price is in USDT.
# The code is internal, the label shown to users lives in PLAN_LABELS below.
PLANS=month:30:39.00,quarter:90:99.00,year:365:349.00

# Optional human labels: code=Label|code=Label
PLAN_LABELS=month=1 month|quarter=3 months|year=1 year


# ── TRON / USDT (TRC20) — the production payment rail ───────────────────────
TRON_ENABLED=true

# YOUR wallet. Subscribers pay straight into it. Gatekit never holds keys
# and never moves funds — it only reads the chain.
TRON_WALLET=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# mainnet | nile | shasta   (use a testnet first — see README "Live test")
TRON_NETWORK=mainnet

# Official USDT TRC20 contract on mainnet (verified on TRONSCAN).
# On Nile/Shasta testnet this differs — see README.
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Optional but recommended. Without a key TronGrid allows about ONE request per
# second, and when you exceed it the response is HTTP 200 with an "Error" field
# rather than a 429 — which a naive bot would read as "no payments arrived".
# Gatekit throttles itself and treats that response as a retryable error, but a
# free key from trongrid.io removes the constraint entirely.
TRON_API_KEY=


# ── TON (optional second rail, matched by payment comment) ──────────────────
TON_ENABLED=false
TON_WALLET=
# Prices in TON, per plan code: code:amount
# There is no FX feed in Gatekit on purpose — you set TON prices explicitly
# so a rate-API outage can never mis-price your subscriptions.
TON_PRICES=month:9.5,quarter:24,year:84
# Optional free key from toncenter.com raises the rate limit.
TON_API_KEY=


# ── Payment matching ────────────────────────────────────────────────────────
# TRC20 transfers carry no memo, so each invoice gets a unique amount:
# 39.00 becomes e.g. 39.004271. Under one cent of variance, 9999 unique slots.
INVOICE_TTL_MINUTES=60
# How long after an invoice expires a late payment is still honoured.
PAYMENT_LATE_TOLERANCE_MINUTES=180
# Tolerance for clock drift between your server and the chain.
CLOCK_SKEW_SECONDS=120
# How often to poll the chain, in seconds.
WATCHER_INTERVAL_SECONDS=30


# ── Access safety (see README "Why it will not kick a paying member") ───────
# true  = never remove anyone, only warn you and them. Start here.
# false = enforce for real.
SAFE_MODE=true

# Extra days of access after a subscription expires.
GRACE_PERIOD_DAYS=2

# Never remove a member who paid within this many hours, whatever the state.
PAYMENT_PROTECTION_HOURS=48

# Send renewal reminders this many days before expiry (comma-separated).
REMINDER_DAYS=3,1

# Minutes an issued single-use invite link stays valid.
INVITE_LINK_TTL_MINUTES=30

# true = an admin must confirm every removal from the admin panel.
REQUIRE_MANUAL_KICK_CONFIRMATION=false

# How often the expiry/reminder sweep runs, in seconds.
SCHEDULER_INTERVAL_SECONDS=300


# ── Storage ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/gatekit.db
LOG_LEVEL=INFO
